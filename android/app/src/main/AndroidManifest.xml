<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- '알림으로 답장' 예비 기능: 우리 알림 "🎤 말로 답장"을 띄움 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 고급 받아쓰기 파일을 와이파이에서 받는지 확인 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 음성 인식 엔진과 카카오톡 앱을 찾기 위해 (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Main">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HelperActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="kr.yunho.talkhelper.helper"
            android:theme="@style/Helper" />

        <!-- 카톡 위 간단 설정 (도우미 버튼을 꾹 눌러 ⚙️) -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="kr.yunho.talkhelper.helper"
            android:theme="@style/Helper" />

        <!-- 대화에서 찾기: 카톡 '대화 내용 내보내기'에서 이 앱으로 공유받음 -->
        <activity
            android:name=".AskActivity"
            android:exported="true"
            android:label="대화에서 찾기"
            android:launchMode="singleTop">
            <!-- 카톡 '대화 내용 내보내기'는 기종에 따라 글 파일을 일반 파일 종류로 보내므로 모든 종류를 받고,
                 받은 뒤 카톡 대화가 아니면 저장하지 않음 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- '알림으로 답장' 예비 기능: 카톡 알림의 답장 칸으로 보냄 (설정에서 켰을 때만, 카톡 알림만 봄) -->
        <service
            android:name=".NotifyReplyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 카톡 위 떠 있는 버튼 + 카톡 입력창에 글을 넣고 전송 -->
        <service
            android:name=".KakaoAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
